# Configuration du deploiement Docker Compose.
# Copier ce fichier en .env  (cp deploy.env.example .env)  puis completer.
# Le .env n'est PAS versionne (secrets).

# Base de donnees
DB_PASSWORD=zak

# Securite JWT (mettre une longue chaine aleatoire en prod)
JWT_SECRET=change-moi-en-prod

# SMTP (rappels de renouvellement) - laisser vide = mode "a blanc" (pas d'envoi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# URL publique du site (pour les liens dans les emails)
APP_BASE_URL=http://localhost:8088

# Rappels
RAPPEL_JOURS=30
SCHEDULER_INTERVALLE=24h

# Stripe (paiement cotisation) - cle secrete mode test (sk_test_...)
STRIPE_SECRET_KEY=
